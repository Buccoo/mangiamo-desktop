{
  "name": "sushiamo-desktop",
  "version": "1.5.49",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "test": "npm run build:ts && node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.electron.json",
    "prepare-config": "node scripts/desktop/generate-runtime-config.mjs",
    "build:ts": "node scripts/desktop/build-electron.mjs",
    "watch:ts": "node scripts/desktop/build-electron.mjs --watch",
    "verify:release": "node scripts/desktop/verify-release-artifacts.cjs dist-desktop",
    "build:win": "npm run prepare-config && npm run build:ts && electron-builder --win nsis --publish never && node scripts/desktop/smoke-packaged-app.cjs && npm run verify:release",
    "build:mac": "npm run prepare-config && npm run build:ts && electron-builder --mac dmg --x64 --arm64 --publish never",
    "build:mac:arm64": "npm run prepare-config && npm run build:ts && electron-builder --mac dmg --arm64 --publish never",
    "build:mac:x64": "npm run prepare-config && npm run build:ts && electron-builder --mac dmg --x64 --publish never",
    "build:mac:unsigned": "npm run prepare-config && npm run build:ts && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --x64 --arm64 --publish never",
    "dev": "npm run prepare-config && concurrently -k -n TS,ELECTRON \"npm run watch:ts\" \"wait-on electron-dist/main.cjs && cross-env ELECTRON_DEV_SERVER_URL=https://manager.mangiamo.app node scripts/desktop/run-electron-dev.mjs\""
  },
  "build": {
    "appId": "online.tattica.sushiamo.desktop",
    "productName": "Mangiamo Desktop",
    "asar": true,
    "afterPack": "./scripts/desktop/verify-packaged-dependencies.cjs",
    "compression": "maximum",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Buccoo/mangiamo-desktop/releases/latest/download"
      }
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron-dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/runtime-config.json",
        "to": "desktop-runtime-config.json"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Mangiamo-Desktop-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "artifactName": "Mangiamo-Desktop-macOS-${arch}.${ext}",
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": true
    },
    "protocols": [
      {
        "name": "Mangiamo Deep Link",
        "schemes": [
          "sushiamo"
        ]
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.94.0",
    "electron-updater": "^6.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.8.3",
    "wait-on": "^9.0.4"
  }
}
